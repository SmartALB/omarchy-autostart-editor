#!/usr/bin/env bash
# Lists the open windows as JSON, for the panel's "add from a running program"
# picker. That is the ONE caller and the ONE subcommand left.
#
# TWO SUBCOMMANDS WERE DELETED WITH THE PLACEMENT HALF: `--workspaces` (the
# workspaces listing, `hyprctl -j workspaces`) and `--match-file` (the
# reconcile matcher that evaluated a program's class regex through `grep -E`
# against the open windows). Nothing calls either any more. The GREP seam and
# the MAX_WORKSPACES / MAX_PROGRAMS caps existed only for them and went too.
#
# The one `hyprctl` this plugin still runs is the `-j clients` below, and it
# reads. Nothing here sets anything in the compositor.
#
# The output of hyprctl is not ours, so the window count is capped before
# anything iterates over it -- the panel spawns work per window, and runtime is
# count times timeout.
#
# HYPRCTL is a named seam, not a PATH trick: Omarchy also lives in /usr/bin, so
# a "clean" PATH excludes nothing.
set -uo pipefail

HYPRCTL="${HYPRCTL:-hyprctl}"

# A named seam like the two above, and the only reason the command line half of
# this script is testable at all: a sandbox cannot create /proc/<pid>/cmdline,
# so the tests point this at a directory of their own.
PROC_DIR="${PROC_DIR:-/proc}"

MAX_WINDOWS=500

# The command line cap. 500 is MAX_COMMAND in Model.js -- the longest command
# that file will write -- so a command line longer than this could not be
# written even if it were offered, and a TRUNCATED one is worse than none: it
# looks like a command and is not one. So past the cap the field is empty and
# the window says it has no offer, rather than offering half a nimbus line.
# (Measured on a real session: a browser --app line reached 452 characters.)
MAX_COMMAND_CHARS=500
# Only the basename of argv 0 is needed for the .desktop-by-binary match, and
# that stays available even when the whole line is past the cap.
MAX_PROGRAM_CHARS=128
# What is read from /proc at all. Bounded before anything looks at it, for the
# same reason the window count is: the content is not ours.
MAX_CMDLINE_BYTES=4096

# One process's command line, NUL-separated in /proc, as one line of text --
# or nothing at all when it cannot be read. An unreadable /proc entry is an
# empty field and never an error: a window belonging to another user, or one
# whose process exited between the two reads, must not cost the whole list.
#
# The tab, the newline and the carriage return are squashed HERE rather than in
# jq, because the pid and the command line travel to jq as one tab-separated
# line: a tab surviving this would shift the field and hand a window someone
# else's command. The remaining control characters are squashed in jq, where
# the class and the title already are.
proc_cmdline() {
    local pid="$1"
    [[ "$pid" =~ ^[0-9]{1,10}$ ]] || return 0
    head -c "$MAX_CMDLINE_BYTES" -- "$PROC_DIR/$pid/cmdline" 2>/dev/null \
        | tr '\0\n\t\r' '    '
    return 0
}

cmd_list_json() {
    local monitors clients
    monitors="$("$HYPRCTL" -j monitors 2>/dev/null)" || monitors=""
    clients="$("$HYPRCTL" -j clients  2>/dev/null)" || clients=""

    if [[ -z "$clients" ]] || ! jq -e 'type == "array"' <<<"$clients" >/dev/null 2>&1; then
        echo "[]"
        return 0
    fi
    jq -e 'type == "array"' <<<"$monitors" >/dev/null 2>&1 || monitors="[]"

    local windows
    windows="$(jq -c --argjson mon "$monitors" --argjson max "$MAX_WINDOWS" '
        # monitors travels through --argjson (argv) while clients is streamed
        # through stdin to respect the MAX_ARG_STRLEN limit. A monitor list is
        # bounded by physical hardware and will never approach that limit;
        # streaming a second input here would need a temporary file with its own
        # cleanup -- more machinery than the inconsistency costs. Kept on purpose.
        ( $mon | map(select(type == "object"))
               | map({ key: (.id | tostring), value: .name }) | from_entries ) as $names
        | map(select(type == "object"))
        | map(select((.workspace.id // 0) > 0))
        | .[0:$max]
        # class and title are sanitized here, once, so the one-line-per-window
        # invariant holds for every consumer of cmd_list_json -- not only
        # cmd_match_file, which resolves a grep hit back to a window by line
        # number and would otherwise misattribute a match whenever an earlier
        # window has a class or title containing an embedded newline. Wayland
        # app_id and X11 WM_CLASS are set by the client, so a buggy or
        # hostile one can put arbitrary bytes there -- this is not exotic.
        #
        # Squashed to a space, not dropped, for the same reason task 6 kept
        # a tab inside a .desktop value rather than deleting it. The trade
        # this makes is real: a window whose actual class contains a control
        # character is reported with a sanitized class, so From window
        # produces a pattern that will not match it and that window cannot
        # be placed. That is the acceptable side of the trade -- a window
        # that cannot be placed, never a different window moved instead.
        | map({
            address:   (.address // ""),
            class:     ((.class // "") | gsub("[[:cntrl:]]"; " ")),
            title:     ((.title // "") | gsub("[[:cntrl:]]"; " ")),
            workspace: ((.workspace.id // 0) | tostring),
            monitor:   ($names[(.monitor // -1) | tostring] // ""),
            # The pid travels only as far as the second pass below, which
            # replaces it with the command line it resolved. Nothing outside
            # this script ever sees it: a pid is stale the moment it is read,
            # and a consumer holding one would eventually act on a process
            # that is no longer the one it looked at.
            pid:       (if (.pid | type) == "number" then (.pid | floor) else -1 end)
          })
    ' <<<"$clients")"

    # The command line per window, resolved once per DISTINCT pid: three
    # nimbus windows are three windows of one process, and the whole reason
    # this is a list of suggestions rather than an automatic mapping.
    local pairs
    pairs="$(
        while IFS= read -r pid; do
            printf '%s\t%s\n' "$pid" "$(proc_cmdline "$pid")"
        done < <(jq -r '.[].pid | select(. > 0) | tostring' <<<"$windows" | sort -u)
    )"

    # NEITHER input travels in argv, and that is measured rather than assumed:
    # MAX_WINDOWS distinct pids at MAX_CMDLINE_BYTES each is far past
    # MAX_ARG_STRLEN (128 KiB for one argument), and a window list of 500
    # titles is not comfortably under it either. An over-long argument does not
    # truncate, it makes execve fail with E2BIG -- jq would never run, and the
    # panel would see an empty window list with nothing to say why. So the
    # window list stays on stdin and the pid/command pairs arrive through
    # --rawfile on a pipe. A pipe rather than a temporary file: there is
    # nothing to clean up on any of this script's several exit paths.
    jq -c --rawfile pairs <(printf '%s' "$pairs") \
          --argjson maxcmd "$MAX_COMMAND_CHARS" \
          --argjson maxprog "$MAX_PROGRAM_CHARS" '
        def clean: gsub("[[:cntrl:]]"; " ") | gsub("  +"; " ") | sub("^ +"; "") | sub(" +$"; "");
        # `last // ""` rather than `last`: jq splits the empty string to the
        # EMPTY ARRAY, whose last element is null -- so a window whose /proc
        # entry could not be read reported a program of null instead of "".
        # Measured, not guessed at: the assertion for it went red.
        def basename: split("/") | last // "";
        ( $pairs | split("\n") | map(select(length > 0) | split("\t"))
                 | map({ key: .[0], value: (.[1] // "") }) | from_entries ) as $cmds
        | map(. + { raw: ($cmds[(.pid | tostring)] // "") })
        | map({ address, class, title, workspace, monitor,
                # Past the cap the field is empty -- see MAX_COMMAND_CHARS.
                command: ((.raw | clean) as $c
                          | if ($c | length) > $maxcmd then "" else $c end),
                # The basename of argv 0, which survives the cap because the
                # .desktop-by-binary match is the route that fixes the two
                # cases /proc cannot answer, and it needs only this word.
                program: ((.raw | clean | split(" ") | first // "" | basename)
                          | .[0:$maxprog]) })
    ' <<<"$windows"
}

# One subcommand, and an argument is still refused rather than ignored: a
# caller that passes the deleted --workspaces or --match-file must see that it
# is gone, not silently receive the window list instead.
case "${1:-}" in
    "") cmd_list_json ;;
    *)  echo "usage: ${0##*/}" >&2; exit 2 ;;
esac
