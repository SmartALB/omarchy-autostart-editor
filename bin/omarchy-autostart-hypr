#!/bin/bash
# Delivers the user's autostart.lua RAW, as one JSON envelope.
#
# It reads. It does not parse, and it does not write -- there is no write
# subcommand here, no staged file beside a destination, no `mv` onto anything
# of the user's. The parser lives in Model.js, where test/harness.qml can
# reach it in the same engine that runs the plugin; a parser in awk would be
# a parser no suite of this project can test.
#
# The file belongs to the USER, is hand-maintained, and often carries the
# owner's own section comments and factual notes. Nothing here may alter one
# byte of it.
# The content is passed through verbatim so that the writer can do line surgery
# against exactly the bytes the reader saw.
#
# A missing file is not an error: it is an entry with present:false. Anything
# else would make an absent autostart.lua look like a broken plugin.
#
# IT READ THREE FILES AND READS ONE. windowrules.lua and workspaces.lua were
# delivered here too, for the listings that are gone; nothing shows them any
# more, and a reader that goes on opening two of the user's files to have their
# contents discarded is work nobody can account for later. FILES stays an ARRAY
# and cmd_read stays a LOOP for the same reason Model.js keeps a list: the
# envelope shape, and the "a file that is absent SAYS so" guarantee, are
# per-name and do not change because there is one name.
set -uo pipefail

# THE EXECUTION BOUNDARY, THIS SCRIPT'S HALF OF IT.
#
# A reported defect, and the third of three: this script edits a file that
# runs at every login, and it reached that file through tools resolved by an
# AMBIENT PATH, under an interpreter resolved the same way. Both are inputs an
# attacker of the same user controls without touching a single byte of this
# repository.
#
# MEASURED, all three legs, rather than assumed (bash 5.3.15, coreutils 9.11):
#
#   PATH=<dir with a fake bash>  ./script  with `#!/usr/bin/env bash`
#       -> THE FAKE RAN. `env` resolves the interpreter through PATH, so the
#          shebang itself was a PATH lookup. Hence `#!/bin/bash` above.
#   BASH_ENV=<file>  ./script
#       -> THE FILE'S CODE RAN BEFORE THE SCRIPT BODY. bash sources $BASH_ENV
#          in a NON-interactive shell. Also measured THROUGH
#          `/usr/bin/timeout`, which is the route the panel actually uses.
#   BASH_ENV=<file>  ./script  with the fixed `#!/bin/bash` shebang
#       -> IT STILL RAN. A fixed interpreter does not close this one.
#
# SO THE TWO HALVES ARE NOT INTERCHANGEABLE, and this block is only one of
# them. BASH_ENV is consumed by bash at STARTUP -- before the first line
# below is read -- so no assignment here can undo it. That half is closed at
# the process boundary, where the panel constructs the environment explicitly
# instead of inheriting it (Runners.qml's toolEnv, with clearEnvironment).
# What this block closes is everything resolved AFTER startup: the tools.
#
# PATH IS SET TO NOTHING, WHICH IS DELIBERATELY STRONGER THAN SETTING IT TO
# /usr/bin:/bin.
#
# A minimal trusted PATH would make a tool name this file forgot to spell
# absolutely keep working -- silently, from a directory that happens to be
# right -- and the whole point of the block below is that there is no such
# name. Empty means a bare name resolves to NOTHING and the script fails
# loudly instead. A missed name becomes a visible bug rather than a quiet
# dependency on the environment, and that is the property the suite probes.
#
# MEASURED, all four scripts, under `env -i` with PATH= and nothing but the
# variables the panel passes: the application list, the Hyprland read, the
# window list (through hyprctl) and a real write all succeed. Nothing in this
# plugin needs a PATH.
#
# The panel still hands the process a minimal PATH of its own (Runners.qml's
# toolEnv) rather than no PATH at all: that is the layer that keeps an
# INHERITED, poisoned PATH out. This line is the layer that makes this file
# independent of any PATH whatsoever.
PATH=
export PATH
# Whitespace, explicitly. An inherited IFS changes how every unquoted
# expansion in this file splits.
IFS=$' \t\n'

# THE TOOLS, ABSOLUTE, IN ONE BLOCK, AND USED AT EVERY CALL SITE BELOW.
# Named here rather than resolved per call so the list is auditable in one
# place; test/run-tests.sh requires this block to be complete and requires no
# bare tool name to survive anywhere in this file's code.
readonly HEAD=/usr/bin/head
readonly JQ=/usr/bin/jq
readonly MKTEMP=/usr/bin/mktemp
readonly MV=/usr/bin/mv
readonly RM=/usr/bin/rm
readonly STAT=/usr/bin/stat
readonly WC=/usr/bin/wc

HYPR_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
MAX_BYTES_PER_FILE=65536   # 64 KiB -- ample for 31 lines
FILES=(autostart.lua)

# One cleanup for the whole script, installed before the first temporary file
# exists. The trap body must never name a function-local variable: the trap
# runs at exit, when that local is out of scope, and under `set -u` the
# expansion is fatal -- so the trap removes nothing and a temporary file
# leaks on every single run. (The deleted bin/omarchy-autostart-config learned
# this the hard way in task 4; the lesson is copied deliberately, not
# rediscovered.)
#
# Two scratch paths, because the loop below runs per file and the
# truncation step needs a second one: everything the script creates lives
# under $TMPDIR, never beside a file of the user's.
TMPFILE=""      # one file's raw bytes
CUTFILE=""      # the same, cut back to exactly the cap
LISTFILE=""     # one JSON object per file, slurped at the end
cleanup() {
    [[ -n "${TMPFILE:-}" ]]  && "$RM" -f -- "$TMPFILE"
    [[ -n "${CUTFILE:-}" ]]  && "$RM" -f -- "$CUTFILE"
    [[ -n "${LISTFILE:-}" ]] && "$RM" -f -- "$LISTFILE"
    return 0
}
trap cleanup EXIT

# Every outcome leaves through one of these two, so a caller parses one
# shape. Even jq itself failing must still produce exactly one JSON object on
# stdout and exit 0 -- otherwise a caller sees nothing at all and cannot tell
# why.
ok() {
    "$JQ" -nc "$@" || printf '{"ok":false,"error":"internal","detail":"could not build the answer"}\n'
    exit 0
}
err() {
    "$JQ" -nc --arg e "$1" --arg d "${2:-}" '{ok:false,error:$e,detail:$d}' \
        || printf '{"ok":false,"error":"internal","detail":"could not build the error answer"}\n'
    exit 0
}

# Read at most MAX+1 bytes and report whether the extra byte arrived. Checking
# the size first and reading afterwards would be a different program: the file
# can change between the two.
#
# Unlike the configuration reader, an oversized file here is NOT refused -- it
# is delivered truncated with the flag set, because the user's own
# configuration must still be SHOWN even when it has grown past what this
# panel expects. Model.js carries the flag through to the panel, and no writer
# may ever do line surgery on a truncated read.
TRUNCATED=false
read_bounded() {
    local src="$1" dst="$2" size
    "$HEAD" -c $((MAX_BYTES_PER_FILE + 1)) "$src" > "$dst" 2>/dev/null \
        || err "unreadable" "could not read $src"
    size="$("$WC" -c < "$dst")"
    if (( size > MAX_BYTES_PER_FILE )); then
        TRUNCATED=true
        # Keep exactly MAX bytes, never MAX+1: the extra byte was read to
        # DETECT the overrun, and handing it on would put a byte in the
        # content that the cap says is not there.
        CUTFILE="$("$MKTEMP")" || err "internal" "could not create a temporary file"
        "$HEAD" -c "$MAX_BYTES_PER_FILE" "$dst" > "$CUTFILE" 2>/dev/null \
            || err "unreadable" "could not truncate the copy of $src"
        "$MV" -f "$CUTFILE" "$dst" || err "internal" "could not replace the scratch copy"
        CUTFILE=""
    fi
}

cmd_read() {
    local name path mtime present

    LISTFILE="$("$MKTEMP")" || err "internal" "could not create a temporary file"
    [[ -n "$LISTFILE" && -f "$LISTFILE" ]] || err "internal" "could not create a temporary file"
    : > "$LISTFILE"

    for name in "${FILES[@]}"; do
        path="$HYPR_DIR/$name"
        present=false
        mtime=0
        TRUNCATED=false

        TMPFILE="$("$MKTEMP")" || err "internal" "could not create a temporary file"
        [[ -n "$TMPFILE" && -f "$TMPFILE" ]] || err "internal" "could not create a temporary file"
        : > "$TMPFILE"

        # -f, not -e: a directory or a socket at that path is not a file this
        # reader can deliver, and reporting it as absent is the honest answer
        # -- there is nothing to show and nothing a later writer could edit.
        if [[ -f "$path" && -r "$path" ]]; then
            # The mtime is captured BEFORE the content, so a caller can never
            # be handed content newer than the stamp it was told about. A file
            # that vanishes here produces the absent entry, not an error
            # envelope: it simply is not there any more.
            if mtime="$("$STAT" -c %Y "$path" 2>/dev/null)" && [[ "$mtime" =~ ^[0-9]+$ ]]; then
                read_bounded "$path" "$TMPFILE"
                present=true
            else
                mtime=0
            fi
        fi

        # --rawfile, so the bytes cross into JSON as one string with no shell
        # word splitting, no `$(...)` stripping of trailing newlines, and no
        # interpretation of a backslash. That matters here more than anywhere
        # else in this plugin: a Lua string literal may carry "\\." and a
        # mangled backslash would silently change the command the panel shows
        # -- and, through the writer, the command that runs at login.
        "$JQ" -nc --arg n "$name" --arg p "$path" \
               --argjson m "$mtime" --argjson pr "$present" --argjson t "$TRUNCATED" \
               --rawfile c "$TMPFILE" \
               '{name:$n, path:$p, present:$pr, mtime:$m, truncated:$t, content:$c}' \
            >> "$LISTFILE" \
            || err "internal" "could not describe $name"

        # Removed here rather than left to the trap: the loop runs once per
        # file and only the last path would otherwise be cleaned up.
        "$RM" -f -- "$TMPFILE"
        TMPFILE=""
    done

    # The order in the array is the order of FILES. Model.js re-establishes it
    # from the names anyway (parseHyprFiles walks HYPR_FILE_NAMES, not this
    # array), so a future reordering here cannot silently reshuffle the panel.
    ok --arg dir "$HYPR_DIR" --slurpfile f "$LISTFILE" \
       '{ok:true, dir:$dir, files:$f}'
}

case "${1:-}" in
    read) shift; cmd_read "$@" ;;
    *)    echo "usage: ${0##*/} read" >&2; exit 2 ;;
esac
