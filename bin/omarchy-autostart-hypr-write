#!/bin/bash
# Writes ~/.config/hypr/autostart.lua, and nothing else.
#
# THE FILE THIS REPLACES RUNS AT EVERY LOGIN. A malformed autostart.lua means
# the user's programs do not start and Hyprland reports a Lua error at the
# next login. Every safeguard here exists for that one sentence.
#
# It does NOTHING with the content -- it gets that finished, on stdin, from
# Model.autostartApply(), which is a pure function and therefore the one place
# where every surgery case is a unit test with a byte-exact expected result.
# This script owns only the byte-level boundaries: the freshness check, the
# permission refusals, the backup, the syntax gate and the atomic rename.
#
# It never runs a program, never talks to hyprctl, and reloads nothing. A
# change takes effect at the next login.
#
# The path is fixed. There is no --file option and no argument that could name
# another one: windowrules.lua and workspaces.lua are read-only in this
# plugin, and a writer that can be pointed at a path is a writer that can be
# pointed at the wrong one.
set -uo pipefail

# THE EXECUTION BOUNDARY, THIS SCRIPT'S HALF OF IT.
#
# A reported defect, and the third of three: this script edits a file that
# runs at every login, and it reached that file through tools resolved by an
# AMBIENT PATH, under an interpreter resolved the same way. Both are inputs an
# attacker of the same user controls without touching a single byte of this
# repository.
#
# MEASURED, all three legs, rather than assumed (bash 5.3.15, coreutils 9.11):
#
#   PATH=<dir with a fake bash>  ./script  with `#!/usr/bin/env bash`
#       -> THE FAKE RAN. `env` resolves the interpreter through PATH, so the
#          shebang itself was a PATH lookup. Hence `#!/bin/bash` above.
#   BASH_ENV=<file>  ./script
#       -> THE FILE'S CODE RAN BEFORE THE SCRIPT BODY. bash sources $BASH_ENV
#          in a NON-interactive shell. Also measured THROUGH
#          `/usr/bin/timeout`, which is the route the panel actually uses.
#   BASH_ENV=<file>  ./script  with the fixed `#!/bin/bash` shebang
#       -> IT STILL RAN. A fixed interpreter does not close this one.
#
# SO THE TWO HALVES ARE NOT INTERCHANGEABLE, and this block is only one of
# them. BASH_ENV is consumed by bash at STARTUP -- before the first line
# below is read -- so no assignment here can undo it. That half is closed at
# the process boundary, where the panel constructs the environment explicitly
# instead of inheriting it (Runners.qml's toolEnv, with clearEnvironment).
# What this block closes is everything resolved AFTER startup: the tools.
#
# PATH IS SET TO NOTHING, WHICH IS DELIBERATELY STRONGER THAN SETTING IT TO
# /usr/bin:/bin.
#
# A minimal trusted PATH would make a tool name this file forgot to spell
# absolutely keep working -- silently, from a directory that happens to be
# right -- and the whole point of the block below is that there is no such
# name. Empty means a bare name resolves to NOTHING and the script fails
# loudly instead. A missed name becomes a visible bug rather than a quiet
# dependency on the environment, and that is the property the suite probes.
#
# MEASURED, all four scripts, under `env -i` with PATH= and nothing but the
# variables the panel passes: the application list, the Hyprland read, the
# window list (through hyprctl) and a real write all succeed. Nothing in this
# plugin needs a PATH.
#
# The panel still hands the process a minimal PATH of its own (Runners.qml's
# toolEnv) rather than no PATH at all: that is the layer that keeps an
# INHERITED, poisoned PATH out. This line is the layer that makes this file
# independent of any PATH whatsoever.
PATH=
export PATH
# Whitespace, explicitly. An inherited IFS changes how every unquoted
# expansion in this file splits.
IFS=$' \t\n'

# THE TOOLS, ABSOLUTE, IN ONE BLOCK, AND USED AT EVERY CALL SITE BELOW.
# Named here rather than resolved per call so the list is auditable in one
# place; test/run-tests.sh requires this block to be complete and requires no
# bare tool name to survive anywhere in this file's code.
readonly CHMOD=/usr/bin/chmod
readonly CP=/usr/bin/cp
readonly DATE=/usr/bin/date
readonly GREP=/usr/bin/grep
readonly HEAD=/usr/bin/head
readonly JQ=/usr/bin/jq
readonly MKTEMP=/usr/bin/mktemp
readonly MV=/usr/bin/mv
readonly RM=/usr/bin/rm
readonly SED=/usr/bin/sed
readonly SLEEP=/usr/bin/sleep
readonly SORT=/usr/bin/sort
readonly STAT=/usr/bin/stat
readonly WC=/usr/bin/wc

HYPR_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr"
TARGET="$HYPR_DIR/autostart.lua"
MAX_BYTES=65536           # the same cap bin/omarchy-autostart-hypr reads with

# A DATED BACKUP PER WRITE, and why the single overwritten one was not enough.
#
# This kept exactly one step back, in autostart.lua.bak, overwritten by the
# next write. Two writes in a row therefore left only the SECOND-TO-LAST state
# recoverable -- and that is not hypothetical: on 2026-09-03 two writes eight
# minutes apart made the state before them unreachable, and reasoning about
# what had happened afterwards was much harder than it needed to be.
#
# THE NAME FOLLOWS THE CONVENTION ALREADY IN THAT DIRECTORY. Omarchy's own
# upgrade wrote autostart.lua.pre-apply.20260828-144312.bak, so a dated
# ".bak" beside the file is the shape a reader of that directory already
# knows. What is added is the AUTHOR: "smartalb-autostart" says which of the
# three writers of that directory made the file, so a later reader can tell
# ours from Omarchy's and from the user's own.
#
#   ours      autostart.lua.smartalb-autostart.20260903-101810.bak
#   Omarchy's autostart.lua.pre-apply.20260828-144312.bak
#   legacy    autostart.lua.bak        <- this script's own, before this change
#
# THE LAST TWO ARE NOT OURS TO TOUCH. autostart.lua.bak is a state the user may
# still want, written by an older version of this script, and it is now left
# exactly where it is: never overwritten, never pruned. Nothing here reads or
# writes any name but the pattern below.
#
# SECONDS, AND SORTABLE BY NAME. `cp -p` preserves the ORIGINAL's mtime onto
# the backup, so a backup's mtime is the age of the CONTENT it holds and not
# the moment it was taken -- sorting by mtime would order these wrongly.
# YYYYMMDD-HHMMSS sorts lexicographically in the same order it sorts
# chronologically, which is why the pruning below sorts by name.
BACKUP_AUTHOR="smartalb-autostart"
# THE OTHER AUTHOR SEGMENT, and it exists for one narrow case: a version of
# autostart.lua that appeared AFTER this write had validated the file and was
# therefore replaced by the publish. Those bytes are not a backup of anything
# this script read -- they are somebody else's newer file -- so they get a
# name of their own rather than being filed among our dated backups.
#
# IT DELIBERATELY DOES NOT MATCH BACKUP_RE OR BACKUP_GLOB. Both require a
# literal "." after "smartalb-autostart", and this name continues
# "-rescued.", so the pruner cannot see a rescued file at all and MAX_BACKUPS
# can never remove one. A rescued file is the only copy of a state nobody else
# saved; nothing in this script deletes it, ever.
RESCUE_AUTHOR="smartalb-autostart-rescued"
BACKUP_GLOB="autostart.lua.$BACKUP_AUTHOR.*.bak"
# ANCHORED, and the anchors are the whole point: a name that merely CONTAINS
# the pattern -- "x.autostart.lua.smartalb-autostart.20260903-101810.bak", or
# ours with ".save" appended -- must not match. The optional "-<n>" is the
# collision suffix taken by a second write inside the same second.
BACKUP_RE="^autostart\.lua\.$BACKUP_AUTHOR\.[0-9]{8}-[0-9]{6}(-[0-9]+)?\.bak\$"
# How many to keep. Unbounded backups turn ~/.config/hypr into a junk drawer;
# five covers a run of edits in one sitting (the two-writes-in-nine-minutes
# case above with room to spare) and stops well short of clutter.
MAX_BACKUPS=5

# A NAMED SEAM, exactly like PROC_DIR in bin/omarchy-autostart-windows and for
# the same reason: without it the "a backup that cannot be taken aborts the
# write" guarantee is untestable. A test cannot know which second the writer
# will land in, so it cannot pre-fill the candidate names, and a test that
# guesses the second is a test that fails when the clock ticks between two
# lines of it -- which the first version of this one did.
#
# IT WIDENS NOTHING. The value is required to be eight digits, a hyphen and
# six digits by the same check the clock's own output passes, so it cannot
# carry a path separator, a "..", or anything but a timestamp -- the backup
# still lands in $HYPR_DIR under our own pattern or the write is refused.
STAMP_OVERRIDE="${OMARCHY_AUTOSTART_STAMP:-}"

# THE SECOND NAMED SEAM, and the narrowest thing in this file that could be
# called one: a whole-second delay inserted at ONE point, immediately before
# the publish.
#
# WHY IT HAS TO EXIST. The publish below detects a version of the file that
# appeared after the validation and preserves it instead of discarding it.
# That branch is reachable only inside a window measured in microseconds, and
# a test that cannot reach it is a test that proves the branch compiles. The
# alternative was an assertion that greps this file for the code it hopes is
# there, which is the shape this project has already been burned by.
#
# WHAT IT CAN AND CANNOT DO. It is validated to a SINGLE DIGIT and handed to
# /usr/bin/sleep. It cannot carry a path, a command, an option, or a number
# large enough to hang the panel -- the panel's own `timeout` is 120 seconds
# and this caps at nine. It can only ever make OUR OWN write slower.
#
# THE HONEST COST, because there is one: someone who can already set this
# process's environment can use it to WIDEN the window this whole fix
# narrows. That is a real regression in exactly the class finding three is
# about -- and it is why finding three's other half matters, since through the
# panel this variable cannot be set at all: Runners.qml's toolEnv is an
# allowlist and this name is not on it. The same argument the two seams above
# already stand on, and this is the weaker seam of the three: HYPRCTL names an
# arbitrary BINARY TO EXECUTE.
PUBLISH_DELAY="${OMARCHY_AUTOSTART_PUBLISH_DELAY:-}"
# AND IT ANNOUNCES THAT IT HAS ENTERED THE WINDOW, which is the difference
# between a deterministic test and a flaky one.
#
# A test that reaches this window by sleeping a fixed amount and hoping is a
# test that fails when the machine is busy -- and it fails in BOTH directions:
# too early and the pre-publish re-check refuses (the substitution never
# reaches this window at all), too late and the exchange has already happened.
# One such flake turned up during the probe run, in the shape the whole
# project distrusts: a green that depended on timing.
#
# So the seam drops a marker immediately before it sleeps, and the tests WAIT
# FOR IT. Once it exists, the re-check above has provably passed and the sleep
# has provably begun, so what the test does next is inside the window by
# construction rather than by luck. The tests also assert that the marker
# appeared, so a run that never reached the window fails loudly instead of
# passing for the wrong reason.
#
# IT CANNOT APPEAR IN PRODUCTION. It is written only on the path guarded by
# the seam, and the seam is unset unless a test sets it -- the panel cannot
# set it at all. Its name deliberately does not begin with ".autostart.lua",
# so it is outside every pattern this script stages, backs up or prunes.
DELAY_MARKER=".publish-delay-entered"
publish_delay() {
    [[ -n "$PUBLISH_DELAY" ]] || return 0
    # A single digit or nothing happens. Not an error: a malformed seam value
    # must not be able to fail a write of the user's.
    [[ "$PUBLISH_DELAY" =~ ^[0-9]$ ]] || return 0
    : > "$HYPR_DIR/$DELAY_MARKER" 2>/dev/null || true
    "$SLEEP" "$PUBLISH_DELAY"
    return 0
}

# One cleanup for the whole script. The trap body must never name a
# function-local variable: the trap runs at exit, when that local is out of
# scope, and under `set -u` the expansion is fatal -- so the trap removes
# nothing and a temporary file leaks on every single run. Here that leak would
# be a dotfile beside the user's own Hyprland configuration. Learned in task
# 4, copied deliberately.
STAGEFILE=""   # the candidate, staged beside the destination
BACKUPTMP=""   # the backup, staged beside the destination before it is named
# THE DESCRIPTOR HELD OPEN ON THE DESTINATION, and the /proc path that reaches
# it. Not in the trap, deliberately: the two above are FILES left in the user's
# directory if nobody removes them, and a descriptor is not -- the kernel
# closes it when this process exits, however it exits. It is closed by name
# after the publish so a reader can see where its life ends.
TARGETFD=""
TARGET_FD_PATH=""
cleanup() {
    [[ -n "${STAGEFILE:-}" ]] && "$RM" -f -- "$STAGEFILE"
    [[ -n "${BACKUPTMP:-}" ]] && "$RM" -f -- "$BACKUPTMP"
    return 0
}
trap cleanup EXIT

# Every outcome leaves through one of these two, so a caller parses one shape.
# Even jq itself failing must still produce exactly one JSON object on stdout
# and exit 0 -- otherwise a caller sees nothing at all and cannot tell why.
ok() {
    "$JQ" -nc "$@" || printf '{"ok":false,"error":"internal","detail":"could not build the answer"}\n'
    exit 0
}
err() {
    "$JQ" -nc --arg e "$1" --arg d "${2:-}" '{ok:false,error:$e,detail:$d}' \
        || printf '{"ok":false,"error":"internal","detail":"could not build the error answer"}\n'
    exit 0
}

# THE SYNTAX GATE, and it is the strongest assurance available here.
#
# Measured: `/usr/bin/luac5.1 -p` exits 0 on a valid file and 1 with a
# diagnostic on `o.launch_on_start("nimbus` ("unfinished string near"). `-p`
# PARSES ONLY -- it writes no output file and it does not execute the chunk: a
# file whose body is `print("x"); os.exit(7)` compiles with exit 0 and prints
# nothing. So a candidate can be checked without running it, which is exactly
# what a file that runs at login needs.
#
# Resolved by RUNNING the candidate binary, not by a PATH lookup and not by
# taking `-x` as proof -- the same shape the Qt6 resolution in
# test/run-qml-tests.sh uses. A wrapper
# earlier in PATH would otherwise be trusted without ever being asked whether
# it is a Lua compiler.
#
# Absent compiler = refusal, not a silent skip. Skipping the gate is the one
# failure mode this script exists to prevent, and lua51 is part of
# omarchy-base.packages, so its absence is a broken system rather than a
# configuration this should tolerate.
resolve_luac() {
    local candidate
    for candidate in /usr/bin/luac5.1 /usr/bin/luac /usr/bin/luac5.4; do
        [[ -x "$candidate" ]] || continue
        "$candidate" -v 2>&1 | "$GREP" -q "^Lua " && { printf '%s\n' "$candidate"; return 0; }
    done
    return 1
}

# Refuse when anyone but the owner can write the file or its directory. The
# lines in this file are command lines executed at login, so a foreign writer
# here is a foreign writer in the user's session. A writable directory is
# enough -- the file can simply be replaced.
#
# Deliberately not -L: if $path is a symlink, GNU `stat -c %a` without -L
# reports the LINK's own mode, which is always 777, so a symlinked
# autostart.lua is refused here as well. That is on purpose. The explicit
# symlink refusal below says so in its own words too, because a reader of
# this script should not have to know that detail to see that the case is
# covered.
check_permissions() {
    local path="$1" kind="$2" mode
    [[ -e "$path" ]] || return 0
    mode="$("$STAT" -c %a "$path" 2>/dev/null)" \
        || err "insecure-permissions" "cannot determine the permissions of $kind $path"
    if (( 8#$mode & 8#22 )); then
        err "insecure-permissions" \
            "$kind $path is writable by group or others (mode $mode); run: chmod g-w,o-w $path"
    fi
}

# EVERYTHING SECURITY-RELEVANT ABOUT THE FILE, ASKED OF THE DESCRIPTOR.
#
# A reported defect, and the reviewer's words for it were exact: the old code
# "checks the pathname first and then opens it with a normal shell
# redirection", and the descriptor was rechecked only for `-f`. So the open
# was a SECOND resolution of the name, unbound to the object that had passed
# the type and permission tests, and owner, mode and link count were never
# asked of the thing actually opened at all.
#
# WHAT THIS IS, STATED PLAINLY: DETECTION, NOT PREVENTION. Bash has no
# O_NOFOLLOW for a redirection -- there is no `exec {fd}<` flag for it and no
# builtin that opens one -- so the open below CAN follow a link that was
# swapped in, and this function's job is to make that impossible to get away
# with rather than impossible to attempt. A substitution is CAUGHT and the
# write is refused; it is not ruled out in advance.
#
# `dd iflag=nofollow` IS a real O_NOFOLLOW open and was measured (it refuses a
# symlink with "Zu viele Ebenen aus symbolischen Links"). It is not usable
# here: it delivers BYTES to a pipe, not a held descriptor, and every
# guarantee downstream in this script -- the freshness check, the backup, the
# mode of the staged file -- is built on holding one. Reaching a real
# O_NOFOLLOW open would mean a second interpreter (python3, perl) in a plugin
# that ships four bash scripts and a QML panel, which is a dependency the
# README would have to declare. Not taken; named here so the choice is
# arguable rather than invisible.
#
# THE IDENTITY COMPARISON IS WHAT SUBSUMES O_NOFOLLOW for the one question
# that matters -- "is this descriptor the object the NAME refers to?" --
# because the two stats it compares disagree on exactly the symlink case.
# MEASURED (bash 5.3.15, coreutils 9.11), a symlink `slink` -> `real`:
#
#   stat -c '%d:%i' slink                (lstat)  -> 58:1754157   the LINK
#   exec {fd}<slink; stat -L -c '%d:%i' /proc/self/fd/$fd -> 58:1754156  the TARGET
#   stat -c '%d:%i' real                 (lstat)  -> 58:1754156
#
# and on a plain file the first and second are the same number. So a
# descriptor reached THROUGH a link can never match the lstat of the name it
# was opened by, whatever the link was pointing at.
#
# DEVICE AND INODE, NOT INODE ALONE: inode numbers are unique per filesystem,
# so a bind mount or a different filesystem swapped in at the name can
# otherwise collide.
#
# THE MODE CHECK LIVES HERE AND NOWHERE ELSE. check_permissions is still
# called for the DIRECTORY, which has no descriptor in this script, but the
# path-based check on the FILE is gone deliberately: keeping both would make
# this one unprobeable -- a mutation removing it would be caught by the other
# and the suite would stay green over a check that had stopped working. The
# wording is the same wording, so the answer the user reads has not changed.
validate_descriptor() {
    local path_ident="$1" fd_path="$2" fields ident uid mode links
    # A plain file and nothing else, asked of the OPEN FILE.
    [[ -f "$fd_path" ]] || err "not-a-file" "$TARGET is not a plain file"
    # ONE stat for all five fields: every fork between the open and the last
    # check is time an attacker gets, so the number of them is part of the
    # guarantee.
    fields="$("$STAT" -L -c '%d:%i %u %a %h' "$fd_path" 2>/dev/null)" \
        || err "not-a-file" "$TARGET could not be inspected after it was opened"
    read -r ident uid mode links <<<"$fields"

    [[ "$ident" =~ ^[0-9]+:[0-9]+$ && "$uid" =~ ^[0-9]+$ \
       && "$mode" =~ ^[0-7]{3,4}$ && "$links" =~ ^[0-9]+$ ]] \
        || err "not-a-file" "implausible metadata for $TARGET"

    # THE OBJECT OPENED IS THE OBJECT NAMED. Anything else means the name was
    # repointed between the tests above and the open, and there is exactly one
    # safe answer to that.
    [[ "$ident" == "$path_ident" ]] \
        || err "substituted" \
               "$TARGET was replaced between being checked and being opened (the open landed on $ident, the name was $path_ident); nothing was written"

    # OURS. This script never runs as root and has no business editing a login
    # file that belongs to somebody else.
    [[ "$uid" == "$EUID" ]] \
        || err "foreign-owner" "$TARGET is owned by uid $uid, not by you (uid $EUID); nothing was written"

    # THE MODE, ON THE DESCRIPTOR. Same test and same sentence as
    # check_permissions, moved onto the object.
    (( 8#$mode & 8#22 )) \
        && err "insecure-permissions" \
               "file $TARGET is writable by group or others (mode $mode); run: chmod g-w,o-w $TARGET"

    # ONE LINK, so this name is the ONLY name for these bytes. A second
    # hardlink is a second door into the file that runs at every login, and it
    # can be in a directory whose permissions say nothing about this one --
    # which is why a link count is a permission question, not a curiosity.
    # Refused rather than warned about, the same way a symlink is: a user who
    # hardlinks their autostart.lua from a dotfiles directory is asking for a
    # write this plugin has no safe way to make.
    [[ "$links" == "1" ]] \
        || err "multiply-linked" \
               "$TARGET has $links hard links, so this is not the only name for it; nothing was written"
    return 0
}

# Read at most MAX+1 bytes and reject when the extra byte arrived. Checking
# the size first and reading afterwards would be a different program: the
# producer can write more between the two.
# IS THIS BASENAME ONE OF OURS? The single predicate every removal goes
# through, and the only thing that decides it is the anchored pattern above.
# Named and separate so a test can hand it the names it must refuse.
is_our_backup() {
    local name="${1:-}"
    [[ -n "$name" ]] || return 1
    # A basename, never a path: everything below derives one, and a separator
    # here would mean the derivation broke rather than that the name is odd.
    [[ "$name" != */* && "$name" != "." && "$name" != ".." ]] || return 1
    [[ "$name" =~ $BACKUP_RE ]]
}

# THE ONLY THING IN THIS SCRIPT THAT DELETES A FILE OF THE USER'S, and it gets
# the same treatment as the installer's scratch removal: it may only ever
# remove a file whose name matches OUR exact pattern, in the one directory,
# and it refuses rather than guesses.
#
# Five conditions, all by construction:
#   * the basename matches the anchored pattern -- so autostart.lua itself,
#     autostart.lua.bak, Omarchy's .pre-apply.*.bak, and any name that merely
#     contains our pattern are all refused;
#   * it is taken as a basename and joined to $HYPR_DIR here, so no caller can
#     hand this a path that leads somewhere else;
#   * never a symlink -- removing one is removing whatever it points at as far
#     as the user is concerned, and the target may not be ours at all;
#   * never a directory;
#   * it must exist as a plain file, so "removed" is never reported for
#     something that was not there.
remove_our_backup() {
    local name="${1:-}" path
    is_our_backup "$name" || return 1
    path="$HYPR_DIR/$name"
    [[ ! -h "$path" ]] || return 1
    [[ -f "$path" ]] || return 1
    "$RM" -f -- "$path"
}

# WHAT WAS ACTUALLY REPLACED, AND WHAT TO DO IF IT WAS NOT WHAT WE VALIDATED.
#
# This runs AFTER the publish and it can only run because the publish is an
# EXCHANGE rather than a one-way rename: `mv --exchange` swaps the two names,
# so the object that was the user's autostart.lua a moment ago is now sitting
# at our staged name, in our hands, where it can be looked at.
#
# MEASURED (coreutils 9.11, RENAME_EXCHANGE), `s` staged and `t` the target:
#
#   mv --exchange -T s t   -> exit 0; t has s's content and s's inode,
#                             AND s NOW HOLDS THE FILE THAT WAS t, inode
#                             preserved (1754147 moved from t to s)
#   mv --exchange -T s t, t missing
#                          -> EXIT 1, NOTHING MOVED. The exchange is
#                             conditional on the target existing, which a
#                             plain `mv -T` is not: that would have CREATED
#                             it.
#   mv --exchange -T s link, link a symlink to victim
#                          -> exit 0; victim UNTOUCHED, the link replaced,
#                             and the LINK ITSELF ends up at s. It does not
#                             follow, exactly like `mv -T`.
#
# THE EXPECTED CASE is that the replaced object is the file this write
# validated -- same inode, same mtime. Its bytes are already in the backup
# taken from the descriptor, so the copy at the staged name is redundant and
# is removed.
#
# THE OTHER CASE is the one the reviewer's second finding is about: something
# replaced or rewrote the file after the last check and before the exchange.
# The old code overwrote that version and left only the OLDER validated bytes
# in the backup, so the newer state was gone with nothing said. Here it is
# PRESERVED under a name of its own and REPORTED, because it is in our hands.
# Nothing on this path deletes it: if it cannot be renamed it is left exactly
# where it is and that path is what the caller is told.
RESCUED_PATH=""
publish_check_replaced() {
    local replaced="$1" want_inode="$2" want_mtime="$3" got base
    RESCUED_PATH=""
    # NANOSECONDS, and LC_ALL=C so the decimal separator is a dot whatever the
    # session's locale is. In whole seconds a rewrite in place inside the same
    # second reads as "the file we validated" and is deleted as redundant --
    # which is the finding this whole function exists to answer, reintroduced
    # by a unit that was too coarse.
    got="$(LC_ALL=C "$STAT" -c '%i %.9Y' -- "$replaced" 2>/dev/null)" || got="unreadable"
    if [[ "$got" == "$want_inode $want_mtime" ]]; then
        # The file we validated, and the backup already holds it.
        "$RM" -f -- "$replaced"
        return 0
    fi
    # NOT the file we validated. Keep it.
    if base="$(backup_name_for_now "$RESCUE_AUTHOR")" \
       && "$MV" -T -- "$replaced" "$HYPR_DIR/$base"; then
        RESCUED_PATH="$HYPR_DIR/$base"
    else
        # No free name, or the rename failed. The bytes matter more than the
        # name: leave the file at the staged path and report THAT.
        RESCUED_PATH="$replaced"
    fi
    return 0
}

# Keep the newest MAX_BACKUPS of OUR backups and remove the rest.
#
# Failure here is deliberately NOT an error the caller sees: the write has
# already succeeded and the user's file is in place, so a backup that could
# not be pruned is clutter, not damage. Refusing the write over it would be
# the worse outcome.
prune_our_backups() {
    local f base names=() sorted=() i
    for f in "$HYPR_DIR/"$BACKUP_GLOB; do
        # An unmatched glob stays literal, so the existence test is what makes
        # "no backups yet" an empty list rather than one bogus entry.
        [[ -e "$f" ]] || continue
        base="${f##*/}"
        is_our_backup "$base" || continue
        names+=("$base")
    done
    (( ${#names[@]} > MAX_BACKUPS )) || return 0
    # By NAME, newest first -- see the comment on BACKUP_AUTHOR for why not by
    # mtime.
    mapfile -t sorted < <(printf '%s\n' "${names[@]}" | "$SORT" -r)
    for (( i = MAX_BACKUPS; i < ${#sorted[@]}; i++ )); do
        remove_our_backup "${sorted[$i]}" || true
    done
    return 0
}

# IS THIS CANDIDATE NAME FREE? `-e` ALONE IS THE WRONG TEST, and getting it
# wrong here was a reported hole in this file: `-e` FOLLOWS a symlink, so a
# DANGLING one reports "does not exist" and its name was taken to be free.
#
# Measured on this machine (bash 5.3.15, coreutils 9.11), on a link whose
# target does not exist:
#
#     -e  FALSE     -L  TRUE      <- dangling symlink
#     -e  TRUE      -L  TRUE      <- symlink to an existing file
#     -e  FALSE     -L  FALSE     <- a name with nothing at it, the free case
#
# So `-e` and `-L` disagree on exactly the case an attacker pre-positions, and
# only requiring BOTH to be false says "nothing is at this name". A symlink of
# any kind at a candidate name is NOT a free name: the caller moves on to the
# next candidate, and if every candidate is taken the write is refused. Either
# outcome is deliberate; writing through the link is the one thing that is not.
#
# The backup names are predictable BY CONSTRUCTION -- author plus a
# second-resolution date -- so "an attacker cannot guess the name" was never
# available as a defence and this check does not lean on it.
# A missing argument answers "not free", the same direction every other
# refusal in this file leans: `${1:?}` would exit the shell here and skip the
# JSON envelope that every outcome is required to leave through.
name_is_free() {
    local name="${1:-}" path
    [[ -n "$name" ]] || return 1
    path="$HYPR_DIR/$name"
    [[ ! -e "$path" && ! -L "$path" ]]
}

# The name this write's backup gets. Free by construction: if the second-
# resolution stamp is already taken -- two writes inside one second -- a
# counter is appended rather than the existing backup being overwritten,
# because silently replacing a saved state is the defect this whole change
# exists to remove. Returning nothing means no free name was found, and the
# caller treats that as a failed backup, which aborts the write.
#
# "Taken" is name_is_free's answer, not `-e`'s; see the comment on it.
backup_name_for_now() {
    local author="${1:-$BACKUP_AUTHOR}" stamp base n
    if [[ -n "$STAMP_OVERRIDE" ]]; then
        stamp="$STAMP_OVERRIDE"
    else
        stamp="$("$DATE" +%Y%m%d-%H%M%S 2>/dev/null)" || return 1
    fi
    [[ "$stamp" =~ ^[0-9]{8}-[0-9]{6}$ ]] || return 1
    base="autostart.lua.$author.$stamp.bak"
    if name_is_free "$base"; then printf '%s\n' "$base"; return 0; fi
    for (( n = 2; n <= 50; n++ )); do
        base="autostart.lua.$author.$stamp-$n.bak"
        if name_is_free "$base"; then printf '%s\n' "$base"; return 0; fi
    done
    return 1
}

read_bounded() {
    local src="$1" dst="$2" size
    "$HEAD" -c $((MAX_BYTES + 1)) "$src" > "$dst" \
        || err "write-failed" "could not read the candidate content"
    size="$("$WC" -c < "$dst")"
    if (( size > MAX_BYTES )); then
        err "too-large" "the candidate exceeds $MAX_BYTES bytes"
    fi
}

cmd_write() {
    local expect_mtime=""
    while (( $# )); do
        case "$1" in
            --expect-mtime)
                # $# -ge 2, not just "$2 is set": with exactly one positional
                # parameter left, `shift 2` is a no-op per the bash manual, so
                # a bare trailing --expect-mtime would leave $1 unchanged and
                # spin this loop forever instead of terminating.
                [[ $# -ge 2 ]] || { usage; exit 2; }
                expect_mtime="$2"
                shift 2
                ;;
            *) usage; exit 2 ;;
        esac
    done
    [[ "$expect_mtime" =~ ^[0-9]+$ ]] || { usage; exit 2; }

    local luac
    luac="$(resolve_luac)" \
        || err "no-lua-compiler" \
               "no working Lua compiler found (tried /usr/bin/luac5.1, /usr/bin/luac, /usr/bin/luac5.4); install lua51"

    check_permissions "$HYPR_DIR" "directory"

    # The file must ALREADY EXIST. This writer does line surgery against bytes
    # that were read, and a file the panel never read is not something it may
    # invent -- Omarchy ships an autostart.lua, and a missing one is a
    # configuration question, not a write.
    #
    # -h before -f: a symlink to a regular file passes -f, and its mode as
    # reported without -L is 777, so it would also trip the permission
    # refusal. Named separately anyway, so the answer says what is actually
    # wrong instead of blaming permissions for a link.
    [[ -e "$TARGET" ]] || err "not-a-file" "$TARGET does not exist"
    [[ ! -h "$TARGET" ]] || err "is-a-symlink" "$TARGET is a symbolic link; this plugin will not write through one"
    [[ -f "$TARGET" ]] || err "not-a-file" "$TARGET is not a plain file"
    [[ -r "$TARGET" ]] || err "not-a-file" "$TARGET cannot be read"

    # THE NAME'S OWN IDENTITY, TAKEN BEFORE THE OPEN so there is something for
    # the descriptor to be compared against afterwards. lstat -- no -L -- on
    # purpose: it is the identity OF THE NAME, and for a symlink that is the
    # link itself, which is what makes the comparison in validate_descriptor
    # disagree on exactly that case.
    #
    # The file's own permission check is NOT here any more. It is asked of the
    # descriptor instead; see validate_descriptor. The DIRECTORY's is above,
    # and stays a path check because there is no descriptor for it here.
    local path_ident
    path_ident="$("$STAT" -c '%d:%i' -- "$TARGET" 2>/dev/null)" \
        || err "not-a-file" "$TARGET disappeared before it could be opened"
    [[ "$path_ident" =~ ^[0-9]+:[0-9]+$ ]] \
        || err "not-a-file" "implausible device and inode numbers for $TARGET"

    # THE DESCRIPTOR, HELD FROM HERE TO THE RENAME.
    #
    # Every refusal above answers about a PATH, and a path is a name another
    # process of the same user can repoint between two lines of this script.
    # So the file is opened ONCE, here, and every question after this -- its
    # modification time, its mode, and the bytes the backup is made of -- is
    # asked of THAT OPEN FILE and not of the name a second time.
    #
    # MEASURED, both primitives rather than assumed (bash 5.3.15, coreutils
    # 9.11), with the path unlinked and a different file put back at it
    # between the open and the reads:
    #
    #   stat -L -c '%Y %i' /proc/self/fd/N  -> the ORIGINAL's mtime and inode
    #   the same stat WITHOUT -L            -> the /proc symlink itself (mode
    #                                          500, "symbolic link"), NOT the
    #                                          file: -L is not optional here,
    #                                          GNU stat does not dereference
    #                                          by default
    #   cp -p /proc/self/fd/N dest          -> the ORIGINAL's bytes, mtime and
    #                                          mode, after the substitution
    #   readlink /proc/self/fd/N            -> "<path> (deleted)"
    #
    # `stat` and `cp` are child processes and /proc/self is THEIRS, not this
    # shell's -- it works because an `exec {fd}<` descriptor is inherited
    # across a fork/exec. Measured too, not assumed.
    exec {TARGETFD}<"$TARGET" \
        || err "not-a-file" "$TARGET could not be opened for reading"
    TARGET_FD_PATH="/proc/self/fd/$TARGETFD"
    # The open resolved the name ONE MORE TIME, so everything that matters
    # about what it landed on is asked again HERE, of the descriptor: that it
    # is a plain file, that it is THE FILE THE NAME REFERS TO, that it is
    # ours, that nobody else can write it, and that this is its only name.
    validate_descriptor "$path_ident" "$TARGET_FD_PATH"

    # THE FRESHNESS CHECK. This is a file the user also maintains by hand: if
    # its mtime is not the one the panel read, somebody has touched it since,
    # and every line number the caller carries may now mean a different line.
    #
    # Through the descriptor, and the INODE is taken with it: the mtime alone
    # cannot tell "the same file, untouched" from "a different file with the
    # same timestamp", which is a state anyone can produce with `touch -r`.
    # Both are what the re-check before the rename compares against.
    # AND AT NANOSECOND PRECISION, WHICH IS A SEPARATE VALUE FOR A REASON.
    #
    # `%Y` is WHOLE SECONDS, and that is what the caller's --expect-mtime is
    # in, so the freshness check against the panel has to stay in seconds.
    # But every comparison this script makes with ITSELF -- "is the file at
    # the name still the one I validated?" -- is too coarse in seconds, and
    # that is not theoretical: MEASURED on tmpfs, two writes to the same file
    # inside one second report the SAME `%Y` and DIFFERENT `%.9Y`. A rewrite
    # IN PLACE inside that second therefore looked identical to "untouched",
    # so the intervening version was deleted as redundant. A flaky test found
    # it; the flake was the defect.
    #
    # LC_ALL=C ON THESE READS. `%.9Y` is a decimal number and this machine's
    # locale prints it with a COMMA (measured: "1788505942,116120693"), which
    # is unusable for a numeric check. Set on the individual calls rather than
    # for the whole script, because a script-wide LC_ALL=C would also reorder
    # `sort` -- which orders the application picker in the other scripts, and
    # keeping that behaviour unchanged was deliberate.
    #
    # WHERE THE FILESYSTEM HAS NO SUB-SECOND TIMESTAMPS this is exactly as
    # strong as `%Y` was and no weaker. btrfs (the real target here) and tmpfs
    # (the sandbox) both store nanoseconds -- checked.
    local current target_inode target_mtime_ns
    current="$("$STAT" -L -c %Y "$TARGET_FD_PATH" 2>/dev/null)" \
        || err "not-a-file" "$TARGET disappeared before it could be checked"
    target_inode="$("$STAT" -L -c %i "$TARGET_FD_PATH" 2>/dev/null)" \
        || err "not-a-file" "$TARGET disappeared before it could be checked"
    [[ "$current" =~ ^[0-9]+$ ]] || err "not-a-file" "implausible modification time for $TARGET"
    [[ "$target_inode" =~ ^[0-9]+$ ]] || err "not-a-file" "implausible inode number for $TARGET"
    target_mtime_ns="$(LC_ALL=C "$STAT" -L -c %.9Y "$TARGET_FD_PATH" 2>/dev/null)" \
        || err "not-a-file" "$TARGET disappeared before it could be checked"
    [[ "$target_mtime_ns" =~ ^[0-9]+\.[0-9]+$ ]] \
        || err "not-a-file" "implausible modification time for $TARGET"
    [[ "$current" == "$expect_mtime" ]] \
        || err "stale" "$TARGET changed on disk (mtime $current, caller expected $expect_mtime); reopen the panel so it reads the file again"

    # Stage beside the destination so the publish is an atomic rename, and
    # give the staged file the ORIGINAL's mode before any content reaches it.
    # Ownership needs nothing: this runs as the owner and never as root.
    STAGEFILE="$("$MKTEMP" "$HYPR_DIR/.autostart.lua.XXXXXX")" \
        || err "write-failed" "could not stage a replacement in $HYPR_DIR"
    [[ -n "$STAGEFILE" && -f "$STAGEFILE" ]] \
        || err "write-failed" "could not stage a replacement in $HYPR_DIR"
    # --reference on the DESCRIPTOR, not on the name: the mode the staged file
    # inherits has to be the mode of the file that was validated. `chmod
    # --reference` dereferences, so the /proc path reads the real mode (640 in
    # the measurement above) and not the 500 of the /proc symlink.
    "$CHMOD" --reference="$TARGET_FD_PATH" "$STAGEFILE" \
        || err "write-failed" "could not give the staged file the permissions of $TARGET"

    read_bounded /dev/stdin "$STAGEFILE"

    # THE GATE. Nothing is renamed into place unless the candidate compiles.
    # A file that does not is left staged and then removed by cleanup, and the
    # ORIGINAL IS NEVER TOUCHED -- the backup below has not even been taken at
    # this point, and the rename is still ahead.
    local diagnostic
    if ! diagnostic="$("$luac" -p "$STAGEFILE" 2>&1)"; then
        # The staged file's name is scratch, and putting it in front of the
        # user would name a file that no longer exists by the time the
        # message is read. Both spellings have to go: Lua abbreviates a long chunk
        # name to its TAIL with a leading "..." (measured -- a 90-character
        # staged path came back as "...e9e/scratchpad/.../.autostart.lua.Rwdrdn"),
        # so a plain substitution of the full path misses it. Matching the
        # basename with everything non-blank in front of it catches both the
        # whole path and the abbreviated tail.
        local staged_name="${STAGEFILE##*/}"
        diagnostic="$(printf '%s\n' "$diagnostic" \
                      | "$SED" -e "s#[^ ]*${staged_name}#autostart.lua#g")"
        err "does-not-compile" \
            "the new autostart.lua would not compile, so nothing was written: $diagnostic"
    fi

    # THE ONLY WAY BACK. ~/.config/hypr is not under version control -- checked
    # -- so this copy is it. One dated copy per write, the newest MAX_BACKUPS
    # kept; see the comment on BACKUP_AUTHOR for the naming and for what this
    # replaced.
    #
    # A failed backup is a refusal, not a warning, and that has not changed:
    # writing without one would leave the user with no way to undo a change to
    # a file that decides whether the session starts what it should. A name
    # that cannot be found free counts as a failed backup for the same reason.
    #
    # AND IT IS WRITTEN THROUGH A NAME NOBODY CAN PRE-POSITION. The name check
    # above cannot be the only guard: it answers about the state of the
    # directory at the moment it runs, and this is a directory another process
    # of the same user can change between that moment and this one. So the
    # bytes go somewhere no attacker can name, and only then take our name.
    #
    # MEASURED, both primitives, rather than assumed (coreutils 9.11):
    #
    #   cp -p src dest, dest a symlink to an existing file
    #       -> exit 0, dest STAYS a symlink, THE LINK'S TARGET IS OVERWRITTEN.
    #          Success reported, bytes in someone else's file. This is the
    #          shape the reviewer's finding is about.
    #   cp -p src dest, dest a DANGLING symlink
    #       -> exit 1, "cannot write through dangling symlink", nothing written.
    #   mv -f src dest, dest a symlink to an existing file
    #       -> exit 0, dest becomes a PLAIN FILE, the target is UNTOUCHED.
    #   mv -f src dest, dest a symlink to a DIRECTORY
    #       -> exit 0, and the file lands INSIDE that directory. Which is why
    #          -T is not decoration: with --no-target-directory the link is
    #          replaced and nothing is written through it.
    #
    # So: `cp -p` into a fresh mktemp name (created O_EXCL, so it cannot be a
    # link somebody left there), then `mv -T` it onto our name. `cp -p` keeps
    # giving the backup the ORIGINAL's mtime and mode, and the rename carries
    # both across -- measured -- so the "a backup's mtime is the age of its
    # CONTENT" property the pruning comment relies on is unchanged.
    local backup_base backup_path
    backup_base="$(backup_name_for_now)" \
        || err "write-failed" "could not find a free backup name in $HYPR_DIR; nothing was written"
    backup_path="$HYPR_DIR/$backup_base"
    BACKUPTMP="$("$MKTEMP" "$HYPR_DIR/.autostart.lua.bak.XXXXXX")" \
        || err "write-failed" "could not stage a backup of $TARGET in $HYPR_DIR; nothing was written"
    # AND IT IS READ FROM THE DESCRIPTOR, NOT FROM THE NAME. This is the half
    # of the finding that is provable rather than narrowed: whatever happens to
    # the path in the meantime, these bytes are the bytes that passed the
    # freshness check -- measured above, `cp -p` through /proc/self/fd/N
    # returned the original content, mtime and mode after the file at the path
    # had been unlinked and replaced. A second `cp` from "$TARGET" here would
    # be a second resolution of the name and could copy someone else's file
    # into the user's backup.
    "$CP" -p -- "$TARGET_FD_PATH" "$BACKUPTMP" \
        || err "write-failed" "could not back $TARGET up to $backup_path; nothing was written"
    "$MV" -T -f -- "$BACKUPTMP" "$backup_path" \
        || err "write-failed" "could not back $TARGET up to $backup_path; nothing was written"
    # Named: the staged backup path no longer exists, so take it out of
    # cleanup's hands rather than have it remove the backup we just took.
    BACKUPTMP=""

    # THE RE-CHECK IMMEDIATELY BEFORE THE PUBLISH. It is the cheap half, and
    # what it is for is the COMMON case: anything slower than a rename that
    # touched the file since the freshness check is refused here, with nothing
    # written and the user's file untouched. It is NOT what closes the window
    # -- see the exchange below for that.
    #
    # BOTH the inode and the mtime, against what the descriptor reported: an
    # inode that no longer matches means the name points at a different file,
    # and an mtime that moved means the same file was written to since.
    #
    # A refusal here leaves the backup that was just taken standing. That is
    # deliberate: it holds the bytes that were validated, so it is a saved
    # state, not damage, and the user's own file is untouched.
    local now_mtime now_inode
    [[ ! -h "$TARGET" ]] \
        || err "is-a-symlink" "$TARGET became a symbolic link while it was being written; nothing was written"
    # ONE stat for both, at nanosecond precision: a rewrite in place inside the
    # same second moves %.9Y and does not move %Y, so this is the reading that
    # can actually tell "untouched" from "written to since".
    local now_fields
    now_fields="$(LC_ALL=C "$STAT" -c '%i %.9Y' -- "$TARGET" 2>/dev/null)" \
        || err "stale" "$TARGET disappeared while it was being written; nothing was written"
    read -r now_inode now_mtime <<<"$now_fields"
    [[ "$now_inode" == "$target_inode" && "$now_mtime" == "$target_mtime_ns" ]] \
        || err "stale" "$TARGET was replaced while it was being written (inode $now_inode, expected $target_inode; mtime $now_mtime, expected $target_mtime_ns); nothing was written -- reopen the panel so it reads the file again"

    # The seam, and nothing but a delay. See PUBLISH_DELAY.
    publish_delay

    # THE PUBLISH, AS AN EXCHANGE RATHER THAN A ONE-WAY RENAME, and this is
    # the answer to the second finding.
    #
    # WHAT THE OLD CODE COULD NOT DO, in the reviewer's words: the final stat
    # and the `mv -T` were separate operations, so "an edit or replacement
    # after the final stat is silently overwritten, while the backup contains
    # the earlier descriptor bytes rather than that intervening version". The
    # previous comment in this place said honestly that the check did not
    # close the window. IT STILL DOES NOT. What has changed is that the window
    # NO LONGER SILENTLY DISCARDS ANYTHING.
    #
    # An exchange is atomic and it leaves EVIDENCE: after it, the thing that
    # was at the name is at OUR name, so the question "was that actually the
    # file we validated?" can be asked AFTERWARDS -- which is the only place
    # it can be asked without a race. If the answer is no, those bytes are
    # preserved under a name of their own and reported. See
    # publish_check_replaced for the measurements.
    #
    # THE PROPERTY THIS BUYS, stated exactly, with the residue named:
    #   * a version appearing before the re-check above -> REFUSED, nothing
    #     written;
    #   * a version appearing between that check and the exchange -> the
    #     exchange publishes the new content and that version is PRESERVED and
    #     NAMED IN THE ANSWER. It is not refused: by the time it can be
    #     detected the exchange has already happened, and undoing it would be
    #     a second exchange with a window of its own, into which a third
    #     version could arrive. Preserve-and-report terminates; undo-on-detect
    #     does not.
    #   * THE RESIDUAL WINDOW IS THEREFORE NOT ZERO. What is zero is the set
    #     of versions that can be overwritten with nothing said, which is what
    #     the finding asked for.
    #
    # WHY NOT flock. It was considered and it is not here. A lock serialises
    # only writers that take it: the two writers it could order are two panel
    # writes, and those are ALREADY handled without it -- the second one's
    # inode/mtime re-check above refuses cleanly. The writer this fix is about
    # is the user's own editor, which takes no lock of ours, so a lock file
    # beside the user's Hyprland configuration would buy nothing and would
    # have to be cleaned up on every exit path.
    #
    # -T on both branches for the reason the old comment gave: without
    # --no-target-directory a $TARGET that became a symlink to a DIRECTORY in
    # the meantime would take the staged file INSIDE it and leave the link
    # standing as the user's autostart.lua.
    local publish_mode="exchange"
    if "$MV" --exchange -T -- "$STAGEFILE" "$TARGET" 2>/dev/null; then
        # The staged name now holds the file that WAS the user's autostart.lua,
        # so it is not scratch any more and cleanup must not remove it. Handed
        # over by name.
        local replaced="$STAGEFILE"
        STAGEFILE=""
        publish_check_replaced "$replaced" "$target_inode" "$target_mtime_ns"
    else
        # TWO REASONS AN EXCHANGE FAILS, AND THEY NEED DIFFERENT ANSWERS.
        #
        # The target being GONE is one of them, and it is a refusal: the
        # exchange is conditional on the target existing (measured), which is
        # the one thing a plain `mv -T` would paper over by creating the file.
        # Distinguished by asking whether the name is there, NOT by reading
        # mv's message -- messages are localised, and this machine answers in
        # German.
        [[ -e "$TARGET" || -L "$TARGET" ]] \
            || err "stale" "$TARGET disappeared while it was being written; nothing was written"
        # The other is that RENAME_EXCHANGE is not available: coreutils older
        # than 9.5 has no --exchange, and a filesystem can refuse the call
        # (NFS, some overlays). ~/.config on Omarchy is ext4 or btrfs, where
        # it works -- measured on this machine -- but a plugin must not refuse
        # to write a user's file over a syscall.
        #
        # SO IT FALLS BACK TO THE OLD ONE-WAY RENAME, WITH THE OLD WEAKNESS,
        # AND SAYS SO IN THE ANSWER. publish:"rename" in the envelope is not
        # decoration: on that path an intervening version CAN still be
        # overwritten silently, and a caller reading the field can tell which
        # of the two guarantees it got.
        publish_mode="rename"
        "$MV" -T -f -- "$STAGEFILE" "$TARGET" || err "write-failed" "could not publish $TARGET"
        STAGEFILE=""
    fi
    # The descriptor's work is done -- it named the file that was replaced, and
    # that file is now the previous state. Closed here rather than left to the
    # kernel so its life ends where a reader can see it.
    exec {TARGETFD}<&-
    TARGETFD=""; TARGET_FD_PATH=""

    local mtime
    mtime="$("$STAT" -c %Y "$TARGET" 2>/dev/null)" \
        || err "write-failed" "$TARGET vanished immediately after it was written"
    [[ "$mtime" =~ ^[0-9]+$ ]] || err "write-failed" "implausible modification time"

    # AFTER the publish, never before: pruning is housekeeping over states that
    # are already saved, and doing it first would remove a backup to make room
    # for one that might then fail to be taken.
    prune_our_backups

    # TWO FIELDS MORE THAN BEFORE, and both are answers to the second finding.
    # `publish` says which guarantee this write got -- "exchange" or the
    # weaker "rename" fallback. `rescued` is empty on every ordinary write and
    # names a file only when a version that appeared after validation was
    # preserved instead of discarded; the panel words it for the user.
    ok --argjson m "$mtime" --arg b "$backup_path" --arg r "$RESCUED_PATH" \
       --arg p "$publish_mode" \
       '{ok:true,mtime:$m,backup:$b,rescued:$r,publish:$p}'
}

usage() {
    echo "usage: ${0##*/} write --expect-mtime <int> < autostart.lua" >&2
}

case "${1:-}" in
    write) shift; cmd_write "$@" ;;
    *)     usage; exit 2 ;;
esac
