#!/usr/bin/env bash
# Removes Autostart Layout.
#
# It removes the plugin and nothing else. There is no configuration of its own
# to keep or delete: the only file it ever wrote is ~/.config/hypr/autostart.lua,
# which is your own file and is left exactly as it stands.
set -euo pipefail

ID="smartalb.autostart"
TARGET="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/$ID"

# Written as `if`, not as `[[ -d x ]] && rm -rf x`: an && chain whose first
# link is false yields status 1, and under `set -e` that is one edit away
# from a script that reports failure for the ordinary case of having nothing
# left to remove. A second run must be quiet and succeed.
if [[ -d "$TARGET" ]]; then
    rm -rf -- "$TARGET"
    echo "Removed $TARGET"
else
    echo "Nothing installed at $TARGET"
fi

cat <<NOTE

Remove the widget from your bar in ~/.config/omarchy/shell.json, then run
omarchy-restart-shell.

Nothing else was touched. Your autostart entries are in your own
~/.config/hypr/autostart.lua and keep working without this plugin; the last
backup it took, if any, is beside it as autostart.lua.bak.
NOTE
